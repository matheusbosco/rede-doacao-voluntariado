ily=DejaVu Sans;fontStyle=0;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="72" y="2048" width="962.1669921875001" height="23.799999999999997" /></mxCell><mxCell id="439" value="Totais e disponibilidade são calculados; não são campos persistidos. As restrições estão no dicionário de dados." style="text;html=0;fillColor=none;strokeColor=none;fontColor=#52647A;fontSize=17;fontFamily=DejaVu Sans;fontStyle=0;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="72" y="2076" width="961.2124023437501" height="23.799999999999997" /></mxCell></root></mxGraphModel></diagram></mxfile>